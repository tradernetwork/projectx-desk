# Copy to .env.projectx (gitignored) and fill it in. `python px_app.py` loads it; real shell variables win.
# Never commit real values. A blank or zero money or quantity limit means REFUSE (see docs/LIMITATIONS.md).
PROJECTX_USERNAME=
PROJECTX_API_KEY=
CHART_PORT=8600

# ---- network exposure (docs/DEPLOY.md). The default is loopback only. ----
# Any other bind (a container, an LXC, another machine) REFUSES TO START without both of these:
#   PX_OPERATOR_TOKEN: a login (HTTP Basic, any username, this as the password): openssl rand -hex 32
#   PX_ALLOWED_HOSTS: the names you reach it by, comma separated (loopback is always allowed)
PX_HOST=127.0.0.1
PX_OPERATOR_TOKEN=
PX_ALLOWED_HOSTS=
# Optional extra allowed Origin values, for example https://desk.example.com behind a TLS proxy.
PX_ALLOWED_ORIGINS=
# 0 = sim data subscription, 1 = live. Unverified against a real account.
PX_LIVE_DATA=0

# ---- the ONE account this desk may touch ----
PX_ACCOUNT_ID=
# sim | live. live also needs PX_ALLOW_LIVE=1
PX_ACCOUNT_KIND=sim
PX_ALLOW_LIVE=0
# Brackets are an account setting. Blank refuses opens. position = stop placed after fill (sim only);
# oco = native atomic bracket (required for live). Prove it on a sim account first.
PX_BRACKET_MODE=

# ---- kill switches (both default OFF) ----
PX_TRADING=0
# Reserved: no route uses it today, MCP never places. Leave 0.
PX_MCP_PLACE=0

# ---- risk limits (zero = refuse) ----
PX_DAILY_LOSS_LIMIT=0
PX_DRAWDOWN_BUFFER=0
PX_MAX_QTY_ORDER=1
PX_MAX_QTY_SYMBOL=2
PX_MAX_QTY_TOTAL=3
PX_MAX_ORDERS_DAY=10
# Behavioral rails: 0 turns a rail OFF; blank or garbled falls back to the default.
PX_COOLDOWN_AFTER_LOSS_S=300
PX_MAX_CONSEC_LOSSES=3
PX_SIZE_AFTER_LOSS_LOCK=1
PX_SIZE_SCALERS=1
PX_ALLOWED_ROOTS=MES,MNQ,MCL,MGC
# HH:MM America/Chicago, at or before 17:00. Blank refuses opens.
PX_NO_NEW_AFTER=

# ---- MCP (mounted at /mcp/ only if the token is strong; generate with: openssl rand -hex 32) ----
PX_MCP_TOKEN=
