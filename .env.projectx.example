# Copy to .env.projectx (gitignored). Never commit real values. A blank or zero limit means REFUSE.
PROJECTX_USERNAME=
PROJECTX_API_KEY=
CHART_PORT=8600
# 0 = sim data subscription, 1 = live. Unverified against a real account.
PX_LIVE_DATA=0

# ---- the ONE account this desk may touch ----
PX_ACCOUNT_ID=
PX_ACCOUNT_KIND=sim            # sim | live. live also needs PX_ALLOW_LIVE=1
PX_ALLOW_LIVE=0
# Brackets are an account setting. Blank refuses opens. position = stop placed after fill (sim only);
# oco = native atomic bracket (required for live). Prove it on a sim account first.
PX_BRACKET_MODE=

# ---- kill switches (both default OFF) ----
PX_TRADING=0
PX_MCP_PLACE=0                 # v1: MCP never places; leave 0

# ---- risk limits (zero = refuse) ----
PX_DAILY_LOSS_LIMIT=0
PX_DRAWDOWN_BUFFER=0
PX_MAX_QTY_ORDER=1
PX_MAX_QTY_SYMBOL=2
PX_MAX_QTY_TOTAL=3
PX_MAX_ORDERS_DAY=10
PX_COOLDOWN_AFTER_LOSS_S=300     # no new opens this long after a losing trade (0 = off)
PX_MAX_CONSEC_LOSSES=3         # locked for the session after this many losses in a row (0 = off)
PX_SIZE_AFTER_LOSS_LOCK=1      # after a loss, risk may not exceed the losing trade's risk
PX_SIZE_SCALERS=1              # ADX/ATR risk cuts (reduce-only, untested thresholds). 0 = off
PX_ALLOWED_ROOTS=MES,MNQ,MCL,MGC
PX_NO_NEW_AFTER=               # HH:MM America/Chicago, at or before 17:00. Blank refuses opens.

# ---- MCP (mounted at /mcp/ only if the token is strong; generate with: openssl rand -hex 32) ----
PX_MCP_TOKEN=
