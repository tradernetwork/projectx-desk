# Copy to .env.projectx (gitignored) and fill it in. `python px_app.py` loads it; real shell variables win.
# Never commit real values. A blank or zero money or quantity limit means REFUSE (see docs/LIMITATIONS.md).
# PROJECTX_USERNAME is the username you use to sign in to your firm's platform (TopstepX). It is NOT your email,
# NOT an account name or id, and the API key screen does not show it. Case does not matter.
# PROJECTX_API_KEY is the key you generate in the platform. Both are required: the login call sends the pair.
PROJECTX_USERNAME=
PROJECTX_API_KEY=
CHART_PORT=8600

# ---- network exposure (docs/DEPLOY.md). The default is loopback only. ----
# Any other bind (a container, an LXC, another machine) REFUSES TO START without both of these:
#   PX_OPERATOR_TOKEN: a login (HTTP Basic, any username, this as the password): openssl rand -hex 32
#   PX_ALLOWED_HOSTS: the names you reach it by, comma separated (loopback is always allowed)
PX_HOST=127.0.0.1
PX_OPERATOR_TOKEN=
PX_ALLOWED_HOSTS=
# Optional extra allowed Origin values, for example https://desk.example.com behind a TLS proxy.
PX_ALLOWED_ORIGINS=
# 0 = sim data subscription, 1 = live. Unverified against a real account.
PX_LIVE_DATA=0

# ---- the ONE account this desk may touch ----
# Numeric id of the trading account (it is not the username and not the account name). Required before any order.
PX_ACCOUNT_ID=
# sim | live. live also needs PX_ALLOW_LIVE=1
PX_ACCOUNT_KIND=sim
PX_ALLOW_LIVE=0
# Brackets are an account setting. Blank refuses opens. position = stop placed after fill (sim only);
# oco = native atomic bracket (required for live). Prove it on a sim account first.
PX_BRACKET_MODE=

# Flatten fallback. 0 (default): if closeContract cannot be confirmed, halt and tell the human to close in the TopstepX UI.
# 1: send one capped opposite-side market order, which can flip a position if the first close executes late.
PX_FLATTEN_FALLBACK=0

# ---- kill switches (both default OFF) ----
PX_TRADING=0
# Reserved: no route uses it today, MCP never places. Leave 0.
PX_MCP_PLACE=0

# ---- risk limits (zero = refuse) ----
PX_DAILY_LOSS_LIMIT=0
PX_DRAWDOWN_BUFFER=0
PX_MAX_QTY_ORDER=1
PX_MAX_QTY_SYMBOL=2
PX_MAX_QTY_TOTAL=3
PX_MAX_ORDERS_DAY=10
# Behavioral rails: 0 turns a rail OFF; blank or garbled falls back to the default.
PX_COOLDOWN_AFTER_LOSS_S=300
PX_MAX_CONSEC_LOSSES=3
PX_SIZE_AFTER_LOSS_LOCK=1
# ADX/ATR risk scalers: OFF by default (ATR already sets the stop distance, so scaling again double-counts). 1 turns them on.
PX_SIZE_SCALERS=0
PX_ALLOWED_ROOTS=MES,MNQ,MCL,MGC
# HH:MM America/Chicago, at or before 17:00. Blank refuses opens.
PX_NO_NEW_AFTER=
# HH:MM America/Chicago: auto-flatten everything at this time and refuse entries in the 2 minutes before. Topstep requires flat by 15:10 CT, so use 15:08 or earlier. Blank means no auto-flatten.
PX_FLAT_BY=
# Holiday / early-close dates, CT, flatten time for each (copy them from Topstep's calendar; there is no built-in calendar):
# PX_EARLY_CLOSES=2026-11-27=12:00,2026-12-24=12:00
PX_EARLY_CLOSES=
# Dollars: the firm's maximum-loss floor as TopstepX shows it. Drawdown room becomes live balance minus this. 0 uses PX_DRAWDOWN_BUFFER. Update it when the floor moves.
PX_MLL_FLOOR=0

# ---- MCP (mounted at /mcp/ only if the token is strong; generate with: openssl rand -hex 32) ----
PX_MCP_TOKEN=

# ---- feeds (all optional; each is OFF until its URL / key is set) ----
# Analyst callouts from the Discord bot (TraderDiscord-v2 GET /analyst-callouts). https only, or http to loopback (an ssh tunnel is fine).
# The key is the bot's API key (X-Bot-Key). Only allowlisted numbers and enums are ever shown; message text never reaches the desk.
# PX_FEED_URL=http://127.0.0.1:8300/analyst-callouts
# PX_FEED_KEY=
# PX_FEED_CHANNELS=futures      # comma-separated substrings of channel names to keep
# PX_FEED_HOURS=24              # look-back window, 1 to 72

# GEX levels (TraderDaddy API), converted to futures prices. Display only: they never feed sizing, stops or targets.
# The key is shared and limited to 30 requests a minute; a failed refresh keeps serving the last good levels.
# PX_GEX_KEY=                   # falls back to TD_API_KEY
# PX_GEX_URL=https://api.traderdaddy.pro/api/v1
# PX_GEX_MAX_AGE_S=900          # 60 to 3600: stop drawing levels older than this

# Tick bars built from the live tape: trade prints per bar, at most 4 distinct values (50 to 50000 each).
# PX_TICK_BARS=1024,2048,4096

# ---- sizing, limits and files ----
# Largest stop the guard accepts, in ticks. Unset = 200. Blank, garbled or negative refuses every stop.
# PX_MAX_STOP_TICKS=200
# drawdown (default): 1R is risk_pct of the live drawdown room (balance minus PX_MLL_FLOOR). remaining: the legacy base.
# PX_RISK_BASE=drawdown
# Holiday and early-close flatten times, CT, copied from Topstep's calendar (the desk ships no calendar):
# PX_EARLY_CLOSES=2026-11-27=12:00,2026-12-24=12:00

# Where the desk keeps its state. All default to files under ./data (gitignored). The tape file holds the buy/sell volume history.
# PX_STATE_PATH=data/day_state.json
# PX_INTENT_PATH=data/intents.json
# PX_AUDIT_PATH=data/audit.jsonl
# PX_HALT_FILE=data/HALT
# PX_FLOW_FILE=data/flow.json
# PX_LOCK_FILE=data/desk.lock   # one desk per checkout; a second start refuses

# ---- loading and development ----
# PX_ENV_FILE=/path/to/other.env   # load this instead of ./.env.projectx
# PX_NO_ENV_FILE=1                 # load no env file at all (the offline mock uses this)
# Point the desk at the offline mock gateway (./run_dev.sh sets these; never set them for a real account):
# PROJECTX_API=http://127.0.0.1:8700
# PROJECTX_HUB_BASE=ws://127.0.0.1:8700/hubs
# DEV_GATEWAY_PORT=8700            # mock gateway only
# DEV_GATEWAY_WALK=0               # mock gateway only: hold the market still

# ---- Opt out of the operator login (home LAN you fully control; sim first). Needs PX_ALLOWED_HOSTS; leave PX_OPERATOR_TOKEN blank. ----
# Anything that can reach the port can stage and place within your caps, and the web page is plain HTTP. Default off.
PX_OPEN_LAN=0

# ---- Volume history (buy/sell tape) ----
# PX_FLOW_DB=data/flow.db        # SQLite; every minute is kept
PX_FLOW_KEEP_DAYS=90             # days to keep; 0 = forever
